# Neon Postgres — the pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth app.
# Callback URL: http://localhost:3000/api/auth/callback/github  (and your Vercel URL in production)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional. Your GitHub username. Set it and only you can sign in.
ALLOWED_GITHUB_LOGIN=""

# Set to your deployment URL in production (Vercel sets this for you).
# AUTH_URL="https://focus-rpg.vercel.app"

# Web push, so a session end reaches a phone with the app closed.
# Generate a pair with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret the external scheduler sends as the x-cron-secret header.
CRON_SECRET=""
